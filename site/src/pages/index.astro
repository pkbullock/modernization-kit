---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { processSteps, repoUrl } from '../data/process.js';

const kitResources = [
  { title: 'PowerShell scripts', path: 'scripts', label: 'Automation', description: 'PnP PowerShell and supporting automation for repeatable modernisation tasks.' },
  { title: 'SPFx solutions', path: 'spfx', label: 'Components', description: 'SharePoint Framework web parts, extensions, and Copilot components.' },
  { title: 'Page layout mappings', path: 'mappings', label: 'Transformation', description: 'XML mappings that connect classic publishing layouts to modern pages.' },
  { title: 'Custom tools', path: 'tools', label: 'Utilities', description: 'Supporting tools for discovery, conversion, and project delivery.' }
];
const communityResources = [
  { title: 'SharePoint modernisation', description: 'Microsoft guidance on moving from classic to modern experiences.', href: 'https://learn.microsoft.com/sharepoint/dev/transform/modernize-user-interface-customizations', image: 'guidance-background-modernize.webp' },
  { title: 'Community guidance', description: 'Practical knowledge shared by Microsoft 365 practitioners.', href: 'https://pnp.github.io/community-docs/', image: 'guidance-background-m365-community-content.webp' },
  { title: 'Sharing is Caring', description: 'Learn how to contribute with help from the PnP community.', href: 'https://pnp.github.io/sharing-is-caring/', image: 'guidance-background-sic.webp' }
];
---
<BaseLayout>
  <section class="intro-band" aria-labelledby="intro-title">
    <div class="container intro grid grid-cols-1 items-center gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(320px,420px)] lg:gap-12">
      <div>
        <p class="eyebrow">MICROSOFT 365 PATTERNS &amp; PRACTICES COMMUNITY</p>
        <h1 id="intro-title">Modernisation Kit</h1>
        <p class="intro-summary">A practical path from classic to modern SharePoint.</p>
        <p class="intro-description">Guidance, tools, and repeatable project patterns to help teams identify classic SharePoint content, plan modernization work, transform pages, and manage review through publication.</p>
        <div class="intro-actions">
          <a class="button button-primary" href="/identify/">Start with discovery <Icon name="heroicons:arrow-right" aria-hidden="true" /></a>
        </div>
      </div>
      <aside class="timeline-card" aria-labelledby="timeline-title">
        <p class="timeline-label">Classic SharePoint retirement</p>
        <h2 id="timeline-title">Upcoming deprecation timeline</h2>
        <ol class="timeline-list">
          <li><time datetime="2026-08-31">Aug 31, 2026</time><span>Microsoft published the classic experiences change announcement.</span></li>
          <li><time datetime="2027-03-01">Mar 1, 2027</time><span>New classic publishing sites and feature activation are disabled for all tenants.</span></li>
          <li><time datetime="2028-10-01">Oct 1, 2028</time><span>Classic user-created pages become read-only across all tenants.</span></li>
        </ol>
        <a class="timeline-link" href="https://techcommunity.microsoft.com/blog/spblog/upcoming-changes-to-classic-experiences-in-sharepoint-online/4549091" target="_blank" rel="noopener noreferrer">Read the Microsoft announcement <Icon name="heroicons:arrow-top-right-on-square" aria-hidden="true" /></a>
      </aside>
    </div>
  </section>

  <section class="container workflow section" aria-labelledby="workflow-title">
    <div class="section-heading">
      <div><p class="eyebrow">THE APPROACH TO PAGE MODERNISATION</p><h2 id="workflow-title">Five stages. One considered rollout.</h2></div>
      <p>From the first inventory to the final approval.</p>
    </div>
    <ol class="workflow-grid">
      {processSteps.map((step, index) => (
        <li>
          <a class="stage-link" href={`/${step.slug}/`}>
            <span class="stage-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.summary}</p>
            <span class="stage-action">Explore stage <Icon name="heroicons:arrow-right" aria-hidden="true" /></span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="kit-band" id="kit" aria-labelledby="kit-title">
    <div class="container section kit-layout">
      <div class="kit-intro">
        <p class="eyebrow">THE TOOLKIT</p>
        <h2 id="kit-title">Resources for the work ahead.</h2>
        <p class="muted">Guidance, automation, and reusable solutions, organised around your modernisation project.</p>
        <p class="development-note"><strong>In development</strong><br />The kit is taking shape. These folders are the starting point for community contributions.</p>
        <a class="text-link" href={repoUrl}>Browse the repository <Icon name="heroicons:arrow-top-right-on-square" aria-hidden="true" /></a>
      </div>
      <div class="kit-grid">
        {kitResources.map((resource) => (
          <a class="kit-resource" href={`${repoUrl}/tree/main/kit/${resource.path}`}>
            <span class="resource-type">{resource.label}</span>
            <h3>{resource.title} <Icon name="heroicons:arrow-top-right-on-square" aria-hidden="true" /></h3>
            <p>{resource.description}</p>
            <span class="resource-path">kit/{resource.path}/</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="container section" id="community" aria-labelledby="community-title">
    <div class="section-heading">
      <div><p class="eyebrow">BETTER TOGETHER</p><h2 id="community-title">Built on community knowledge.</h2></div>
      <a class="text-link" href="https://pnp.github.io/">Meet the community <Icon name="heroicons:arrow-top-right-on-square" aria-hidden="true" /></a>
    </div>
    <div class="community-grid">
      {communityResources.map((resource) => (
        <a class="community-resource" href={resource.href}>
          <img src={`https://pnp.github.io/images/${resource.image}`} alt="" width="640" height="320" loading="lazy" decoding="async" />
          <div><h3>{resource.title} <Icon name="heroicons:arrow-top-right-on-square" aria-hidden="true" /></h3><p>{resource.description}</p></div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  @import '../styles/home.css';
</style>
