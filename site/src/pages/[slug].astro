---
import BaseLayout from '../layouts/BaseLayout.astro';
import { processSteps, repoUrl } from '../data/process.js';

interface Props {
  step: (typeof processSteps)[number];
  index: number;
}

export function getStaticPaths() {
  return processSteps.map((step, index) => ({ params: { slug: step.slug }, props: { step, index } }));
}

const { step, index } = Astro.props;
const previous = processSteps[index - 1];
const next = processSteps[index + 1];
---
<BaseLayout title={`${step.title} | Modernisation Kit`} description={step.summary}>
  <div class="container stage-page">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Modernisation Kit</a><span aria-hidden="true">/</span><span aria-current="page">{step.title}</span></nav>
    <div class="reading-layout">
      <aside>
        <p class="eyebrow">MODERNISATION WORKFLOW</p>
        <nav aria-label="Workflow stages">
          <ol>
            {processSteps.map((item, position) => (
              <li><a href={`/${item.slug}/`} aria-current={item.slug === step.slug ? 'page' : undefined}><span aria-hidden="true">{String(position + 1).padStart(2, '0')}</span>{item.title}</a></li>
            ))}
          </ol>
        </nav>
        <a class="contribute" href={`${repoUrl}/tree/main/docs`}>Contribute guidance <span aria-hidden="true">&#8599;</span></a>
      </aside>
      <article>
        <p class="eyebrow">STAGE {index + 1} OF {processSteps.length}</p>
        <h1>{step.title}</h1>
        <p class="summary">{step.summary}</p>
        <div class="status-note"><strong>Guidance in development</strong><p>Detailed guidance and kit assets for this stage are being developed. Contributions and practical examples are welcome.</p></div>
        <h2>Focus for this stage</h2>
        <ul class="checklist">{step.tasks.map((task: string) => <li>{task}</li>)}</ul>
        <h2>Before moving on</h2>
        <p class="muted">{step.outcome}</p>
        <div class="reference"><p class="eyebrow">FURTHER READING</p><a href="https://learn.microsoft.com/sharepoint/dev/transform/modernize-user-interface-customizations">SharePoint modernisation guidance on Microsoft Learn <span aria-hidden="true">&#8599;</span></a></div>
        <nav class="stage-pagination" aria-label="Previous and next stages">
          <a href={previous ? `/${previous.slug}/` : '/'}><span>{previous ? 'Previous stage' : 'Back to'}</span><strong>&#8592; {previous?.title ?? 'Overview'}</strong></a>
          <a class="next" href={next ? `/${next.slug}/` : '/#kit'}><span>{next ? 'Next stage' : 'Explore'}</span><strong>{next?.title ?? 'The toolkit'} &#8594;</strong></a>
        </nav>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .stage-page { padding-block: 1.75rem 4rem; }
  .breadcrumb { display: flex; flex-wrap: wrap; gap: 0.75rem; font-size: 0.8rem; color: var(--cp-text-muted); margin-bottom: 2.5rem; }
  .breadcrumb a { text-decoration: none; }
  .reading-layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 4rem; }
  aside { border-right: 1px solid var(--cp-border); padding-right: 1.5rem; }
  aside .eyebrow { font-size: 0.7rem; }
  aside ol { list-style: none; padding: 0; margin: 0 0 1.5rem; }
  aside nav a { display: flex; gap: 0.85rem; padding: 0.75rem; text-decoration: none; color: var(--cp-text-muted); border-left: 2px solid transparent; font-size: 0.9rem; }
  aside nav a[aria-current='page'] { background: var(--cp-accent-soft); color: var(--cp-accent); border-left-color: var(--cp-accent); font-weight: 600; }
  aside nav a:hover { background: var(--cp-surface-soft); }
  aside nav a span { font-size: 0.8rem; }
  .contribute { font-size: 0.8rem; text-decoration: none; }
  article { max-width: 760px; min-width: 0; }
  .summary { color: var(--cp-text-muted); font-size: 1.2rem; max-width: 650px; }
  .status-note { padding: 1rem 1.25rem; border-left: 3px solid var(--cp-accent); background: var(--cp-accent-soft); margin-block: 2rem; font-size: 0.9rem; }
  .status-note p { color: var(--cp-text-muted); margin: 0.5rem 0 0; }
  article h2 { font-size: 1.5rem; margin-top: 2rem; }
  .checklist { padding-left: 1.25rem; color: var(--cp-text-muted); }
  .checklist li { padding-left: 0.35rem; margin-bottom: 0.8rem; }
  .checklist li::marker { color: var(--cp-accent); }
  .reference { margin-block: 2rem; padding-block: 1.5rem; border-block: 1px solid var(--cp-border); font-size: 0.9rem; }
  .stage-pagination { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .stage-pagination a { text-decoration: none; padding-block: 0.75rem; }
  .stage-pagination span { display: block; color: var(--cp-text-muted); font-size: 0.8rem; margin-bottom: 0.35rem; }
  .stage-pagination strong { font-size: 0.95rem; }
  .stage-pagination .next { text-align: right; }
  @media (max-width: 800px) { .reading-layout { grid-template-columns: 1fr; gap: 1.5rem; } aside { display: none; } }
</style>