---
import { Icon } from 'astro-icon/components';
import { processSteps, repoUrl } from '../data/process.js';

const { title = 'Modernisation Kit | Microsoft 365 Patterns & Practices', description = 'Community guidance and resources for planning, delivering, and reviewing SharePoint page modernisation.' } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const headerLinks = [
  { label: 'Getting started', href: '/identify/' },
  { label: 'Resources', href: '/resources/' },
  { label: 'Contributing', href: repoUrl }
];
---
<!doctype html>
<html lang="en-GB" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const param = new URLSearchParams(window.location.search).get('scoutTheme');
        let saved;
        try { saved = localStorage.getItem('modernization-kit-theme'); } catch {}
        const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const theme = [param, saved].find((value) => value === 'light' || value === 'dark') || preferred;
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[#f8f4f1] text-stone-900 antialiased">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="border-b border-[#ead9de] bg-[#fbf5f2] shadow-[inset_0_-1px_0_rgba(177,31,75,0.06)]">
      <div class="mx-auto flex max-w-[1800px] items-center justify-between gap-5 px-5 py-4 lg:px-8">
        <a class="flex items-center gap-3 text-stone-900 no-underline hover:no-underline" href="/" aria-label="Modernisation Kit home">
          <span class="flex h-16 w-16 items-center justify-center">
            <img class="h-16 w-16 object-contain" src="/SharePoint_512_logo.png" alt="" aria-hidden="true" width="64" height="64" />
          </span>
          <span class="text-3xl font-black tracking-[-0.03em] text-[#2a2023] lg:text-[2.2rem]">
            Modernization <span class="text-[#b11f4b]">Kit</span>
          </span>
        </a>

        <nav class="hidden items-center gap-3 text-[1.05rem] font-semibold text-stone-700 lg:flex" aria-label="Primary navigation">
          {headerLinks.map((link) => (
            <a
              href={link.href}
              class={`rounded-md px-4 py-2 no-underline transition-colors hover:bg-[#b11f4b]/10 hover:text-[#8f183a] hover:no-underline ${currentPath === link.href || (link.href.startsWith('#') && currentPath === '/') ? 'bg-[#b11f4b]/10 text-[#8f183a]' : 'text-stone-700'}`}
            >
              {link.label}
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-3">
          <a class="inline-flex items-center justify-center rounded-full border border-[#e0c8cf] bg-white/70 px-4 py-2 text-sm font-semibold text-stone-700 no-underline shadow-sm transition hover:border-[#b11f4b]/40 hover:text-[#8f183a] hover:no-underline" href={repoUrl}>
            GitHub <Icon name="heroicons:arrow-top-right-on-square" class="ml-1 h-4 w-4" aria-hidden="true" />
          </a>
          <label class="theme-toggle" title="Toggle dark and light theme" aria-label="Toggle dark and light theme">
            <input type="checkbox" role="switch" id="theme-toggle" class="sr-only" />
            <span class="theme-toggle-track">
              <span class="theme-toggle-icon sun"><Icon name="heroicons:sun" aria-hidden="true" /></span>
              <span class="theme-toggle-thumb"></span>
              <span class="theme-toggle-icon moon"><Icon name="heroicons:moon" aria-hidden="true" /></span>
            </span>
          </label>
        </div>
      </div>
    </header>

    <div class="border-b border-[#ead9de] bg-[#fbf5f2]">
      <nav class="mx-auto flex max-w-[1800px] gap-3 overflow-x-auto px-5 py-3 text-[1.05rem] font-semibold text-stone-700 lg:hidden" aria-label="Primary mobile navigation">
        {headerLinks.map((link) => (
          <a href={link.href} class="shrink-0 whitespace-nowrap rounded-md px-3 py-2 no-underline transition hover:bg-[#b11f4b]/10 hover:text-[#8f183a] hover:no-underline">{link.label}</a>
        ))}
      </nav>
    </div>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer>
      <div class="container footer-inner">
        <div><strong>Sharing is caring.</strong><p>A community-led SharePoint modernisation project.</p></div>
        <nav aria-label="Community links">
          <a href="https://pnp.github.io/">Microsoft 365 &amp; Power Platform Community <Icon name="heroicons:arrow-top-right-on-square" aria-hidden="true" /></a>
          <a href={repoUrl}>Contribute on GitHub <Icon name="heroicons:arrow-top-right-on-square" aria-hidden="true" /></a>
        </nav>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLInputElement>('#theme-toggle');
      if (toggle) {
        const preferredTheme = (() => {
          try {
            const saved = localStorage.getItem('modernization-kit-theme');
            if (saved === 'light' || saved === 'dark') return saved;
          } catch {}
          return 'light';
        })();

        document.documentElement.dataset.theme = preferredTheme;
        toggle.checked = preferredTheme === 'dark';
        toggle.setAttribute('aria-checked', String(toggle.checked));
        toggle.addEventListener('change', () => {
          const theme = toggle.checked ? 'dark' : 'light';
          document.documentElement.dataset.theme = theme;
          toggle.setAttribute('aria-checked', String(toggle.checked));
          try { localStorage.setItem('modernization-kit-theme', theme); } catch {}
        });
      }
    </script>
  </body>
</html>

<style is:global>
  @import 'tailwindcss';

  @theme {
    --font-sans: Aptos, "Segoe UI", ui-sans-serif, system-ui, sans-serif;
    --font-display: Aptos, "Segoe UI", ui-sans-serif, system-ui, sans-serif;
    --font-mono: "Cascadia Code", Consolas, ui-monospace, SFMono-Regular, monospace;
  }

  :root {
    color-scheme: light;
    --cp-bg: #f7f4ef;
    --cp-bg-elevated: #fcfbf8;
    --cp-surface: #ffffff;
    --cp-surface-soft: #f5f5f5;
    --cp-border: #dedede;
    --cp-border-strong: #919191;
    --cp-text: #242424;
    --cp-text-muted: #5c5c5c;
    --cp-text-soft: #6f6f6f;
    --cp-accent: #b11f4b;
    --cp-accent-hover: #9a1a41;
    --cp-accent-soft: rgba(177, 31, 75, 0.08);
    --cp-accent-fg: #ffffff;
    --cp-success: #16a34a;
    --cp-danger: #dc2626;
    --cp-warning: #f59e0b;
    --cp-link: #8f183a;
    --cp-shadow: 0 18px 48px rgba(0, 0, 0, 0.12);
    --cp-overlay: rgba(255, 255, 255, 0.8);
    --cp-panel: rgba(255, 255, 255, 0.86);
    --cp-panel-strong: rgba(255, 255, 255, 0.96);
    --cp-sheen: rgba(255, 255, 255, 0.55);
    --cp-highlight: rgba(177, 31, 75, 0.12);
  }
  html[data-theme='dark'] {
    color-scheme: dark;
    --cp-bg: #21191c;
    --cp-bg-elevated: #2a2023;
    --cp-surface: #1f1b1c;
    --cp-surface-soft: #2d2427;
    --cp-border: #5a4149;
    --cp-border-strong: #8b6671;
    --cp-text: #f5eeee;
    --cp-text-muted: #d7c5ca;
    --cp-text-soft: #c6aeb6;
    --cp-accent: #ff8dab;
    --cp-accent-hover: #ff759b;
    --cp-accent-soft: rgba(255, 141, 171, 0.14);
    --cp-accent-fg: #2a1018;
    --cp-success: #4ade80;
    --cp-danger: #f87171;
    --cp-warning: #fbbf24;
    --cp-link: #ff9fba;
    --cp-shadow: 0 18px 48px rgba(0, 0, 0, 0.32);
    --cp-overlay: rgba(41, 41, 41, 0.88);
    --cp-panel: rgba(41, 41, 41, 0.72);
    --cp-panel-strong: rgba(41, 41, 41, 0.96);
    --cp-sheen: rgba(255, 255, 255, 0.04);
    --cp-highlight: rgba(253, 142, 161, 0.12);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 1rem; }
  body { margin: 0; background: var(--cp-surface); color: var(--cp-text); font-family: var(--font-sans); line-height: 1.6; letter-spacing: 0; min-height: 100vh; display: flex; flex-direction: column; }
  main { flex: 1; }
  a { color: var(--cp-link); text-underline-offset: 4px; }
  a:hover { text-decoration: underline; }
  button, input { font: inherit; }
  :focus-visible { outline: 3px solid var(--cp-link); outline-offset: 5px; }
  .container { width: min(1160px, calc(100% - 4rem)); margin-inline: auto; }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2, h3 { font-family: var(--font-display); line-height: 1.2; font-weight: 650; text-wrap: balance; }
  h1 { font-size: 3.5rem; margin-bottom: 1.25rem; }
  h2 { font-size: 2rem; margin-bottom: 1rem; }
  h3 { font-size: 1.25rem; }
  .eyebrow { color: var(--cp-accent); font-size: 0.8rem; font-weight: 700; margin-bottom: 0.75rem; }
  .muted { color: var(--cp-text-muted); }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 0.75rem; min-height: 44px; padding: 0.7rem 1.2rem; border-radius: 4px; font-weight: 600; text-decoration: none; border: 1px solid var(--cp-border-strong); color: var(--cp-text); }
  .button:hover { background: var(--cp-surface-soft); text-decoration: none; }
  .button-primary { background: var(--cp-accent); border-color: var(--cp-accent); color: var(--cp-accent-fg); }
  .button-primary:hover { background: var(--cp-accent-hover); }
  .skip-link { position: absolute; left: 1rem; top: -6rem; z-index: 20; padding: 0.75rem; background: var(--cp-surface); }
  .skip-link:focus { top: 1rem; }
  header { background: var(--cp-surface); }
  .masthead { min-height: 94px; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; padding-block: 1rem; }
  .brand { display: flex; align-items: center; gap: 0.85rem; color: var(--cp-text); text-decoration: none; }
  .brand:hover { text-decoration: none; }
  .brand strong { display: block; font-size: 1.15rem; }
  .brand-mark { display: block; width: 5.35rem; height: 5.35rem; border-right: 1px solid var(--cp-border); padding-right: 0.85rem; object-fit: contain; }
  .brand-caption { display: block; font-size: 0.75rem; color: var(--cp-text-muted); }
  .header-actions { display: flex; gap: 1.75rem; align-items: center; font-size: 0.875rem; }
  .header-actions > a { color: var(--cp-text); text-decoration: none; }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    user-select: none;
  }
  .theme-toggle-track {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 4.5rem;
    height: 2.1rem;
    padding: 0.25rem 0.45rem;
    border-radius: 9999px;
    border: 1px solid rgba(15, 23, 42, 0.12);
    background: #dfe9ea;
    box-shadow: inset 0 2px 4px rgba(15, 23, 42, 0.06);
    transition: background 180ms ease;
  }
  .theme-toggle-thumb {
    position: absolute;
    left: 0.25rem;
    top: 50%;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 9999px;
    background: #ffffff;
    box-shadow: 0 1px 4px rgba(15, 23, 42, 0.18);
    transform: translateY(-50%);
    transition: transform 180ms ease;
  }
  .theme-toggle-icon {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    font-size: 0.75rem;
    opacity: 0.8;
  }
  .theme-toggle-icon svg { width: 1rem; height: 1rem; }
  .theme-toggle-icon.sun { margin-left: 0.1rem; }
  .theme-toggle-icon.moon { margin-right: 0.15rem; }
  #theme-toggle:checked + .theme-toggle-track {
    background: #dfe9ea;
  }
  #theme-toggle:checked + .theme-toggle-track .theme-toggle-thumb {
    transform: translate(2.35rem, -50%);
  }
  #theme-toggle:checked + .theme-toggle-track .theme-toggle-icon.sun {
    opacity: 0.6;
  }
  #theme-toggle:checked + .theme-toggle-track .theme-toggle-icon.moon {
    opacity: 1;
  }
  .nav-border { border-block: 1px solid var(--cp-border); }
  .primary-nav { display: flex; gap: 2rem; overflow-x: auto; }
  .primary-nav a { padding-block: 0.85rem; flex-shrink: 0; border-bottom: 3px solid transparent; color: var(--cp-text-muted); text-decoration: none; font-size: 0.875rem; font-weight: 600; }
  .primary-nav a:hover { color: var(--cp-accent); }
  .primary-nav a[aria-current='page'] { color: var(--cp-accent); border-bottom-color: var(--cp-accent); }
  footer { border-top: 1px solid var(--cp-border); background: var(--cp-surface-soft); padding-block: 2.5rem; }
  .footer-inner { display: flex; justify-content: space-between; gap: 2rem; font-size: 0.875rem; }
  .footer-inner p { margin: 0.5rem 0 0; color: var(--cp-text-muted); }
  .footer-inner nav { display: grid; gap: 0.5rem; }
  .footer-inner a { display: inline-flex; align-items: center; gap: 0.35rem; text-decoration: none; }
  .footer-inner a svg { width: 1rem; height: 1rem; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  @media (max-width: 700px) {
    .container { width: calc(100% - 2.5rem); }
    h1 { font-size: 2.5rem; }
    h2 { font-size: 1.65rem; }
    .masthead { flex-wrap: wrap; gap: 0.5rem; padding-block: 0.8rem; }
    .header-actions { width: 100%; justify-content: space-between; }
    .primary-nav { gap: 1.5rem; }
    .footer-inner { flex-direction: column; }
  }
</style>