---
import { Icon } from 'astro-icon/components';
import BaseLayout from './BaseLayout.astro';
import { getProcessPathDetails, getProcessStepBySlug, processSteps, repoUrl } from '../data/process.js';
import { withBasePath } from '../utils/withBasePath';

const { frontmatter } = Astro.props;
const { stageSlug, sectionSlug } = getProcessPathDetails(Astro.url.pathname, import.meta.env.BASE_URL);
const currentStep = getProcessStepBySlug(frontmatter.stage ?? frontmatter.slug ?? stageSlug);
const index = currentStep ? processSteps.indexOf(currentStep) : 0;
const previous = processSteps[index - 1];
const next = processSteps[index + 1];
const title = frontmatter.title ?? currentStep?.title ?? 'Page Modernisation';
const summary = frontmatter.summary ?? currentStep?.summary ?? '';
---
<BaseLayout title={`${title} | Modernisation Kit`} description={summary}>
  <div class="container stage-page">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href={withBasePath('/')}>Modernisation Kit</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>
    <div class="reading-layout">
      <aside>
        <p class="eyebrow">PAGE MODERNISATION WORKFLOW</p>
        <nav aria-label="Page Modernisation workflow stages">
          <ol>
            {processSteps.map((item, position) => {
              const isCurrentStep = item.slug === currentStep?.slug;

              return (
                <li>
                  <a
                    href={withBasePath(`/${item.slug}/`)}
                    class={isCurrentStep ? 'is-active' : undefined}
                    aria-current={isCurrentStep && !sectionSlug ? 'page' : undefined}
                  >
                    <span aria-hidden="true">{String(position + 1).padStart(2, '0')}</span>
                    {item.title}
                  </a>
                  {isCurrentStep && item.sections?.length ? (
                    <>
                      <span id={`stage-subnav-${item.slug}`} class="sr-only">{item.title} subsection navigation</span>
                      <ol class="stage-subnav" aria-labelledby={`stage-subnav-${item.slug}`}>
                        {item.sections.map((section) => (
                          <li>
                            <a
                              href={withBasePath(`/${item.slug}/${section.slug}/`)}
                              class={section.slug === sectionSlug ? 'is-active' : undefined}
                              aria-current={section.slug === sectionSlug ? 'page' : undefined}
                            >
                              {section.title}
                            </a>
                          </li>
                        ))}
                      </ol>
                    </>
                  ) : null}
                </li>
              );
            })}
          </ol>
        </nav>
        <a class="contribute" href={`${repoUrl}/tree/main/docs`}>Contribute guidance <Icon name="heroicons:arrow-top-right-on-square" aria-hidden="true" /></a>
      </aside>
      <article>
        <p class="eyebrow">STAGE {index + 1} OF {processSteps.length}</p>
        <h1>{title}</h1>
        <p class="summary">{summary}</p>
        <div class="stage-content">
          <slot />
        </div>
        <div class="reference"><p class="eyebrow">FURTHER READING</p><a href="https://learn.microsoft.com/en-us/sharepoint/dev/transform/assess-sharepoint-modernization">SharePoint Page Modernisation guidance on Microsoft Learn <Icon name="heroicons:arrow-top-right-on-square" aria-hidden="true" /></a></div>
        <nav class="stage-pagination" aria-label="Previous and next stages">
          <a href={previous ? withBasePath(`/${previous.slug}/`) : withBasePath('/')}><span>{previous ? 'Previous stage' : 'Back to'}</span><strong><Icon name="heroicons:arrow-left" aria-hidden="true" /> {previous?.title ?? 'Overview'}</strong></a>
          <a class="next" href={next ? withBasePath(`/${next.slug}/`) : withBasePath('/#kit')}><span>{next ? 'Next stage' : 'Explore'}</span><strong>{next?.title ?? 'The toolkit'} <Icon name="heroicons:arrow-right" aria-hidden="true" /></strong></a>
        </nav>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  @import '../styles/stage.css';
</style>
