---
import { Icon } from 'astro-icon/components';
import BaseLayout from './BaseLayout.astro';
import { processSteps, repoUrl } from '../data/process.js';

const { frontmatter } = Astro.props;
const currentStep = processSteps.find((step) => step.slug === frontmatter.slug);
const index = currentStep ? processSteps.indexOf(currentStep) : 0;
const previous = processSteps[index - 1];
const next = processSteps[index + 1];
const title = frontmatter.title ?? currentStep?.title ?? 'Page Modernisation';
const summary = frontmatter.summary ?? currentStep?.summary ?? '';
---
<BaseLayout title={`${title} | Modernisation Kit`} description={summary}>
  <div class="container stage-page">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Modernisation Kit</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>
    <div class="reading-layout">
      <aside>
        <p class="eyebrow">PAGE MODERNISATION WORKFLOW</p>
        <nav aria-label="Page Modernisation workflow stages">
          <ol>
            {processSteps.map((item, position) => (
              <li><a href={`/${item.slug}/`} aria-current={item.slug === frontmatter.slug ? 'page' : undefined}><span aria-hidden="true">{String(position + 1).padStart(2, '0')}</span>{item.title}</a></li>
            ))}
          </ol>
        </nav>
        <a class="contribute" href={`${repoUrl}/tree/main/docs`}>Contribute guidance <Icon name="heroicons:arrow-top-right-on-square" aria-hidden="true" /></a>
      </aside>
      <article>
        <p class="eyebrow">STAGE {index + 1} OF {processSteps.length}</p>
        <h1>{title}</h1>
        <p class="summary">{summary}</p>
        <div class="status-note"><strong>Guidance in development</strong><p>Detailed guidance and kit assets for this stage are being developed. Contributions and practical examples are welcome.</p></div>
        <div class="stage-content">
          <slot />
        </div>
        <div class="reference"><p class="eyebrow">FURTHER READING</p><a href="https://learn.microsoft.com/sharepoint/dev/transform/modernize-user-interface-customizations">SharePoint Page Modernisation guidance on Microsoft Learn <Icon name="heroicons:arrow-top-right-on-square" aria-hidden="true" /></a></div>
        <nav class="stage-pagination" aria-label="Previous and next stages">
          <a href={previous ? `/${previous.slug}/` : '/'}><span>{previous ? 'Previous stage' : 'Back to'}</span><strong><Icon name="heroicons:arrow-left" aria-hidden="true" /> {previous?.title ?? 'Overview'}</strong></a>
          <a class="next" href={next ? `/${next.slug}/` : '/#kit'}><span>{next ? 'Next stage' : 'Explore'}</span><strong>{next?.title ?? 'The toolkit'} <Icon name="heroicons:arrow-right" aria-hidden="true" /></strong></a>
        </nav>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .stage-page { padding-block: 1.75rem 4rem; }
  .breadcrumb { display: flex; flex-wrap: wrap; gap: 0.75rem; font-size: 0.8rem; color: var(--cp-text-muted); margin-bottom: 2.5rem; }
  .breadcrumb a { text-decoration: none; }
  .reading-layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 4rem; }
  aside { border-right: 1px solid var(--cp-border); padding-right: 1.5rem; }
  aside .eyebrow { font-size: 0.7rem; }
  aside ol { list-style: none; padding: 0; margin: 0 0 1.5rem; }
  aside nav a { display: flex; gap: 0.85rem; padding: 0.75rem; text-decoration: none; color: var(--cp-text-muted); border-left: 2px solid transparent; font-size: 0.9rem; }
  aside nav a[aria-current='page'] { background: var(--cp-accent-soft); color: var(--cp-accent); border-left-color: var(--cp-accent); font-weight: 600; }
  aside nav a:hover { background: var(--cp-surface-soft); }
  aside nav a span { font-size: 0.8rem; }
  .contribute { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; text-decoration: none; }
  .contribute svg { width: 1rem; height: 1rem; }
  article { max-width: 760px; min-width: 0; }
  .summary { color: var(--cp-text-muted); font-size: 1.2rem; max-width: 650px; }
  .status-note { padding: 1rem 1.25rem; border-left: 3px solid var(--cp-accent); background: var(--cp-accent-soft); margin-block: 2rem; font-size: 0.9rem; }
  .status-note p { color: var(--cp-text-muted); margin: 0.5rem 0 0; }
  .stage-content :global(h2) { font-size: 1.5rem; margin-top: 2rem; }
  .stage-content :global(ul) { padding-left: 1.25rem; color: var(--cp-text-muted); }
  .stage-content :global(li) { padding-left: 0.35rem; margin-bottom: 0.8rem; }
  .stage-content :global(li::marker) { color: var(--cp-accent); }
  .stage-content :global(p) { color: var(--cp-text-muted); }
  .reference { margin-block: 2rem; padding-block: 1.5rem; border-block: 1px solid var(--cp-border); font-size: 0.9rem; }
  .reference a { display: inline-flex; align-items: center; gap: 0.35rem; }
  .reference a svg { width: 1rem; height: 1rem; }
  .stage-pagination { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .stage-pagination a { text-decoration: none; padding-block: 0.75rem; }
  .stage-pagination span { display: block; color: var(--cp-text-muted); font-size: 0.8rem; margin-bottom: 0.35rem; }
  .stage-pagination strong { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.95rem; }
  .stage-pagination strong svg { width: 1rem; height: 1rem; }
  .stage-pagination .next strong { justify-content: flex-end; }
  .stage-pagination .next { text-align: right; }
  @media (max-width: 800px) { .reading-layout { grid-template-columns: 1fr; gap: 1.5rem; } aside { display: none; } }
</style>