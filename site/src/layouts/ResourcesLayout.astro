---
import { Icon } from 'astro-icon/components';
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
---
<BaseLayout title={`${frontmatter.title} | Modernisation Kit`} description={frontmatter.description}>
  <section class="container resources-page" aria-labelledby="resources-title">
    <p class="eyebrow">{frontmatter.eyebrow}</p>
    <h1 id="resources-title">{frontmatter.title}</h1>
    <p class="summary">{frontmatter.summary}</p>

    <div class="placeholder-panel">
      <Icon name="heroicons:archive-box" aria-hidden="true" />
      <div class="resource-markdown">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .resources-page { padding-block: 3.5rem 5rem; }
  .summary { max-width: 720px; color: var(--cp-text-muted); font-size: 1.2rem; }
  .placeholder-panel { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.25rem; max-width: 780px; margin-top: 2rem; padding: 1.5rem; border: 1px solid var(--cp-border); border-top: 4px solid var(--cp-accent); border-radius: 8px; background: var(--cp-panel-strong); box-shadow: 0 18px 40px rgba(177, 31, 75, 0.08); }
  .placeholder-panel > svg { width: 2.25rem; height: 2.25rem; color: var(--cp-accent); }
  .resource-markdown :global(h2) { font-size: 1.35rem; margin-bottom: 0.5rem; }
  .resource-markdown :global(p) { color: var(--cp-text-muted); margin-bottom: 1rem; }
  .resource-markdown :global(a) { display: inline-flex; align-items: center; gap: 0.35rem; font-weight: 700; text-decoration: none; }
  .resource-markdown :global(a:hover) { text-decoration: underline; }
  @media (max-width: 700px) {
    .resources-page { padding-block: 2.5rem 4rem; }
    .placeholder-panel { grid-template-columns: 1fr; }
  }
</style>
